# ─────────────────────────────────────────────────────────────────────────────
# Rotinas — camada privada OPCIONAL (servidor em server/)
#
# O app funciona 100% local sem nenhuma destas variáveis: hábitos, metas,
# agenda, diário, relatórios, exportação e importação ficam no IndexedDB do
# seu navegador. Estas variáveis só ativam Kai (IA) e o Google Calendar.
#
# Uso no seu computador: copie para ".env" (nunca versione o .env).
# Uso na Vercel: cadastre as mesmas variáveis em Project → Settings →
# Environment Variables (marque "Sensitive" nas secretas) e publique de novo.
# Nenhuma destas variáveis é enviada ao navegador.
# ─────────────────────────────────────────────────────────────────────────────

# Endereço do servidor privado no seu computador. Mantenha 127.0.0.1 para que
# só este computador acesse a API. O Vite (porta 5173) encaminha /api para cá.
# (Na Vercel estas duas não são usadas.)
ROTINAS_SERVER_HOST=127.0.0.1
ROTINAS_SERVER_PORT=8787

# Origem do app no navegador (checagem de origem). Em desenvolvimento:
# http://127.0.0.1:5173 — em produção local (npm start): http://127.0.0.1:8787.
# Na Vercel é deduzida do domínio de produção (não precisa definir).
APP_ORIGIN=http://127.0.0.1:5173

# Senha da SUA camada privada. Obrigatória na Vercel (12+ caracteres): sem ela,
# tudo fica bloqueado. No seu computador é opcional. Você informa a mesma senha
# em cada aparelho (tela "Conectar Kai e Google"). Na Vercel, ela também deriva
# as chaves que cifram os tokens do Google e assinam as autorizações.
# Não é a chave da Anthropic nem do Google.
ROTINAS_SERVER_TOKEN=

# ── Kai (Anthropic) ──────────────────────────────────────────────────────────
# Chave da API (platform.claude.com/settings/keys). Sem ela, o Kai fica desativado.
ANTHROPIC_API_KEY=
# Modelos (IDs conferidos em platform.claude.com/docs/en/models/overview em out/2026).
# Rápido/econômico: conversa, próximo passo e sessão da noite. Mais capaz: plano
# inicial, revisão semanal e divisão de metas.
KAI_MODEL_FAST=claude-haiku-5-5
KAI_MODEL_DEEP=claude-sonnet-5-5
# Limites de uso (proteção de custo): por minuto e por dia (dia UTC). Na Vercel o
# teto diário é guardado no Blob; o limite de gasto do Console é o teto definitivo.
KAI_RATE_LIMIT_PER_MINUTE=10
KAI_DAILY_LIMIT=80
# Máximo de tokens de saída por resposta e tempo limite da chamada (ms).
KAI_MAX_OUTPUT_TOKENS=2000
KAI_TIMEOUT_MS=45000

# ── Google Calendar (opcional) ───────────────────────────────────────────────
# Crie um cliente OAuth do tipo "Web application" no Google Cloud (Google Auth
# Platform → Clients), ative a Google Calendar API e cadastre exatamente esta
# URI de redirecionamento. Na Vercel, não defina GOOGLE_REDIRECT_URI: ela é
# https://<seu-domínio-de-produção>/api/calendar/callback (a tela "Conectar Kai
# e Google" mostra o valor exato para copiar).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/calendar/callback
# Chave para criptografar os tokens OAuth no servidor (32 bytes em base64).
# Opcional quando ROTINAS_SERVER_TOKEN está definida (a chave é derivada dela).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Onde o servidor local guarda os tokens criptografados (fora do controle de versão).
# Na Vercel, os tokens ficam cifrados num armazenamento Blob privado do projeto.
GOOGLE_TOKEN_FILE=.data/google-calendar.enc
