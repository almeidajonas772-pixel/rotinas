# ─────────────────────────────────────────────────────────────────────────────
# Rotinas — camada privada OPCIONAL (servidor em server/)
#
# O app funciona 100% local sem nenhuma destas variáveis: hábitos, metas,
# agenda, diário, relatórios, exportação e importação ficam no IndexedDB do
# seu navegador. Estas variáveis só ativam Kai (IA) e o Google Calendar.
#
# Copie para ".env" (nunca versione o .env) e preencha apenas o que for usar.
# Nenhuma destas variáveis é enviada ao navegador.
# ─────────────────────────────────────────────────────────────────────────────

# Endereço do servidor privado. Mantenha 127.0.0.1 para que só este computador
# acesse a API. O Vite (porta 5173) encaminha /api para cá.
ROTINAS_SERVER_HOST=127.0.0.1
ROTINAS_SERVER_PORT=8787

# Origem do app no navegador (usada para checar a origem das requisições e
# para o retorno do OAuth). Em desenvolvimento: http://127.0.0.1:5173
# Em produção local (npm start): http://127.0.0.1:8787
APP_ORIGIN=http://127.0.0.1:5173

# Opcional (recomendado se o servidor ficar acessível fora deste computador):
# senha da SUA camada privada. Se definida, cada chamada à /api precisa enviar
# este valor; você o informa uma vez em Configurações → Servidor privado.
# Não é a chave da Anthropic nem do Google.
ROTINAS_SERVER_TOKEN=

# ── Kai (Anthropic) ──────────────────────────────────────────────────────────
# Chave da API da Anthropic (console.anthropic.com). Sem ela, Kai fica desativado.
ANTHROPIC_API_KEY=
# Modelos (IDs conferidos em platform.claude.com/docs/en/models/overview em out/2026).
# Rápido/econômico: conversa e próximo passo. Mais capaz: plano inicial,
# revisão semanal e divisão de metas.
KAI_MODEL_FAST=claude-haiku-5-5
KAI_MODEL_DEEP=claude-sonnet-5-5
# Limites de uso (proteção de custo): por minuto e por dia (dia UTC).
KAI_RATE_LIMIT_PER_MINUTE=6
KAI_DAILY_LIMIT=60
# Máximo de tokens de saída por resposta e tempo limite da chamada (ms).
KAI_MAX_OUTPUT_TOKENS=2000
KAI_TIMEOUT_MS=45000

# ── Google Calendar (opcional) ───────────────────────────────────────────────
# Crie um "OAuth client ID" do tipo "Web application" no Google Cloud Console,
# ative a Google Calendar API e cadastre exatamente esta URI de redirecionamento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/calendar/callback
# Chave para criptografar os tokens OAuth guardados no servidor (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Onde o servidor guarda os tokens criptografados (fora do controle de versão).
GOOGLE_TOKEN_FILE=.data/google-calendar.enc
